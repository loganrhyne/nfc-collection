# NFC Collection Environment Configuration
# Copy this to .env and adjust as needed.
#
# Only the variables listed here are read by the code. Anything else you find
# in older docs or env files is dead and has no effect.

# HTTP / Socket.IO port for the unified server
PORT=8000

# --- LED grid ---------------------------------------------------------------

# Grid geometry. grid_rows * grid_cols must equal num_pixels or the server
# refuses to start.
LED_NUM_PIXELS=300
LED_GRID_ROWS=15
LED_GRID_COLS=20

# Set true when the data line enters the strip from the corner opposite the
# one where logical (0,0) should live. With the current odd row count this is
# a 180-degree rotation of the whole grid.
LED_REVERSE_CHAIN=false

# Minutes of visualization idle time before the grid turns itself off
LED_AUTO_OFF_MINUTES=15

# Run without WS2812B hardware (development off-Pi)
LED_MOCK_MODE=false

# --- NFC reader -------------------------------------------------------------

# Run without a PN532 attached (development off-Pi)
NFC_MOCK_MODE=false
